LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./atelier.db
CHECK_SANDBOX=true
RUN_MAX_SECONDS=180
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_NODE_IMAGE=node:20-slim
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=64
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
DEFAULT_SPEND_CEILING_TOKENS=1000000
SPEND_ALERT_THRESHOLDS=50,80,95
TASK_ESTIMATE_S_TOKENS=2000
TASK_ESTIMATE_M_TOKENS=8000
SPEND_ESTIMATE_MULTIPLE=2.0
SPEND_ESTIMATE_MARGIN=1.5
